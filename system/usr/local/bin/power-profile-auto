#!/bin/sh
# Picks a power profile from the charger state:
#   charger connected -> balanced
#   on battery        -> power-saver
#   no battery (desktop PC) -> balanced
# Run by a udev rule when the charger is plugged in or removed, and once at boot.
# Works on most laptops. Needs power-profiles-daemon.

supplies=${POWER_SUPPLY_DIR:-/sys/class/power_supply}
has_battery=no
on_charger=no
for supply in "$supplies"/*; do
    case "$(cat "$supply/type" 2>/dev/null)" in
        Battery) has_battery=yes ;;
        Mains) [ "$(cat "$supply/online" 2>/dev/null)" = 1 ] && on_charger=yes ;;
    esac
done

# A desktop PC has no battery, so it always gets balanced
if [ "$has_battery" = no ] || [ "$on_charger" = yes ]; then
    profile=balanced
else
    profile=power-saver
fi

# Ask power-profiles-daemon over D-Bus. This does the same as
# "powerprofilesctl set", but doesn't need Python.
exec /usr/bin/busctl set-property \
    org.freedesktop.UPower.PowerProfiles \
    /org/freedesktop/UPower/PowerProfiles \
    org.freedesktop.UPower.PowerProfiles \
    ActiveProfile s "$profile"
