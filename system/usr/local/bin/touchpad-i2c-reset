#!/bin/sh
# MSI Modern 15 F13M: at boot the kernel disables the touchpad I2C controller's
# interrupt (IRQ 27), so the touchpad fails to start with error -110.
# Restarting the controller driver turns the interrupt back on.

PCI=0000:00:15.0
DRIVER=/sys/bus/pci/drivers/intel-lpss
TOUCHPAD=/sys/bus/i2c/devices/i2c-LITE0650:00

touchpad_ready() {
    [ -e "$TOUCHPAD/driver" ]
}

# The kernel already reported the -110 failure for the touchpad this boot
already_failed() {
    journalctl -k -b -q --no-pager 2>/dev/null |
        grep -q 'i2c-LITE0650:00: can.t add hid device: -110'
}

# Give the normal startup up to 10 seconds. If the touchpad works, do nothing.
# If the kernel already reported the failure, don't wait: restart right away.
# (The login screen waits for this script, so a shorter wait means a faster
# login screen.)
i=0
while [ "$i" -lt 10 ]; do
    touchpad_ready && exit 0
    already_failed && break
    sleep 1
    i=$((i + 1))
done

# Otherwise restart the controller, up to three times.
for attempt in 1 2 3; do
    [ -e "$DRIVER/$PCI" ] && echo "$PCI" > "$DRIVER/unbind"
    sleep 1
    echo "$PCI" > "$DRIVER/bind"
    sleep 3
    if touchpad_ready; then
        echo "Touchpad started after controller restart (attempt $attempt)"
        exit 0
    fi
done

echo "Touchpad still not available after 3 controller restarts" >&2
exit 1
