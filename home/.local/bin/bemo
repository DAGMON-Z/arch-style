#!/usr/bin/env python3
"""BEMO: a tiny cassette-tape desk buddy for Hyprland.

BEMO sits in a corner of the screen and keeps you company:
  * it codes on its own little laptop while you work,
  * reads a book (with glasses) while you study,
  * falls asleep while you are away or the screen is locked,
  * drinks a coffee with you when you tell it you are having one.

Usage:
  bemo run            start the buddy
  bemo run --demo     cycle through every mood (preview)
  bemo coffee         start / stop a coffee together
  bemo away | back    tell BEMO you left / came back (hypridle calls these)
  bemo say TEXT       make BEMO say something
  bemo stats          print today's focus time
  bemo waybar         JSON line for a waybar custom module
  bemo quit           stop the buddy

Click BEMO to see today's stats. Right-click it to share a coffee.
"""

import json
import math
import os
import random
import signal
import socket
import subprocess
import sys
import time
from datetime import date, datetime
from fnmatch import fnmatch
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
SOCK = RUNTIME / "bemo.sock"
STATUS = RUNTIME / "bemo.json"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "bemo"
STATS_FILE = STATE_DIR / "stats.json"
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "bemo/config.json"

DEFAULTS = {
    # Window classes (shell-style patterns, case-insensitive).
    "work_classes": [
        "kitty", "alacritty", "foot", "*wezterm*", "code", "code-oss", "codium", "vscodium",
        "jetbrains-*", "*zed*", "neovide", "emacs", "*terminal*", "godot", "dbeaver",
        "postman", "insomnia", "*ghostty*",
    ],
    "study_classes": [
        "obsidian", "*zathura*", "*okular*", "*evince*", "libreoffice*", "soffice", "anki",
        "*xournal*", "*rnote*", "sioyek", "calibre*", "*foliate*", "logseq", "*papers*",
    ],
    "browser_classes": [
        "brave-browser", "chromium", "google-chrome*", "firefox", "vivaldi*", "opera", "zen*",
    ],
    # In a browser, the tab title decides. First match wins: study, then work.
    "study_title_words": [
        ".pdf", "lecture", "course", "coursera", "udemy", "edx", "khan academy", "moodle",
        "classroom", "wikipedia", "notion", "google docs", "quiz", "exam", "tutorial",
        "learn", "lesson", "tryhackme", "hack the box", "geeksforgeeks", "w3schools",
        "mdn web docs", "documentation", "notes", "study",
    ],
    "work_title_words": [
        "github", "gitlab", "stack overflow", "localhost", "127.0.0.1", "firebase",
        "google cloud", "console.", "devpost", "vercel", "netlify", "jira", "figma",
        "leetcode", "codeforces", "claude", "chatgpt",
    ],
    "break_minutes": 50,      # nudge to stretch after this much focus in a row
    "coffee_minutes": 15,     # a coffee ends by itself after this long
    "away_minutes": 5,        # no keyboard/mouse for this long = you are away, BEMO sleeps
    "margin_right": 18,
    "margin_bottom": 14,
}

# Tokyo Night, to match the waybar theme.
def rgb(h, a=1.0):
    h = h.lstrip("#")
    return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255, a)

BG = rgb("#1a1b26")
BODY_TOP = rgb("#363b58")
BODY_BOT = rgb("#24283b")
LINE = rgb("#565f89")
WINDOW = rgb("#13141c")
FG = rgb("#c0caf5")
EYE = rgb("#e8ebf8")
DIM = rgb("#414868")
BLUE = rgb("#7aa2f7")
CYAN = rgb("#7dcfff")
GREEN = rgb("#9ece6a")
YELLOW = rgb("#e0af68")
ORANGE = rgb("#ff9e64")
RED = rgb("#f7768e")
MAGENTA = rgb("#bb9af7")
TAPE = rgb("#8a5a44")
PAGE = rgb("#e6dfcc")
FONT = "JetBrainsMono Nerd Font"

MOODS = {
    "idle": ("[o‿o]", "BEMO is hanging out"),
    "work": ("[o_o]", "BEMO is coding with you"),
    "study": ("[o‿o]", "BEMO is studying with you"),
    "coffee": ("[^‿^]", "BEMO is having a coffee with you"),
    "sleep": ("[-_-]", "BEMO is asleep until you come back"),
    "wake": ("[O○O]", "BEMO just woke up"),
    "stretch": ("\\[o‿o]/", "BEMO is stretching"),
}


def load_config():
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(CONFIG_FILE.read_text()))
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as err:
        print(f"bemo: ignoring {CONFIG_FILE}: {err}", file=sys.stderr)
    return cfg


def fmt_dur(seconds):
    m = int(seconds // 60)
    if m < 60:
        return f"{m}m"
    return f"{m // 60}h{m % 60:02d}m"


# ---------------------------------------------------------------- client side

def send(cmd):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        s.sendto(cmd.encode(), str(SOCK))
        return 0
    except (FileNotFoundError, ConnectionRefusedError):
        print("bemo is not running (start it with: bemo run)", file=sys.stderr)
        return 1
    finally:
        s.close()


def print_waybar():
    try:
        print(STATUS.read_text().strip())
    except OSError:
        print(json.dumps({"text": "", "tooltip": "BEMO is not running", "class": "off"}))


def print_stats():
    try:
        day = json.loads(STATS_FILE.read_text()).get(date.today().isoformat(), {})
    except (OSError, ValueError):
        day = {}
    print(f"Today: {fmt_dur(day.get('work', 0))} work, {fmt_dur(day.get('study', 0))} study, "
          f"{day.get('coffee', 0)} coffee(s)")


# ---------------------------------------------------------------- the buddy

class Bemo:
    W, H = 270, 200

    def __init__(self, demo=False):
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GLib, Gtk, GtkLayerShell
        import cairo
        self.GLib, self.Gtk, self.cairo = GLib, Gtk, cairo

        self.cfg = load_config()
        self.demo = demo
        self.t0 = time.monotonic()
        self.last_frame = self.t0
        self.activity = "idle"
        self.window_title = ""
        self.away = False
        self.locked = False
        self.away_since = None
        self.coffee_until = 0.0
        self.transient = None          # (mode, until)
        self.bubble = None             # (text, start, until)
        self.last_chatter = 0.0
        self.last_late_nudge = 0.0
        self.hop_until = 0.0
        self.streak = 0.0
        self.reel_angle = 0.0
        self.cx = self.W / 2
        self.stats = self._load_stats()
        self.margin_right = self._load_position()
        self.press = None          # (pointer x at press, moved?) while the button is down
        self.drag_vx = 0.0
        self.GtkLayerShell = GtkLayerShell
        self.ev_buf = b""

        win = Gtk.Window()
        win.set_title("bemo")
        win.set_default_size(self.W, self.H)
        win.set_app_paintable(True)
        visual = win.get_screen().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "bemo")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, self.cfg["margin_bottom"])
        GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, self.margin_right)
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)

        area = Gtk.DrawingArea()
        area.set_size_request(self.W, self.H)
        from gi.repository import Gdk
        area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.BUTTON1_MOTION_MASK)
        area.connect("motion-notify-event", self.on_drag)
        area.connect("button-release-event", self.on_release)
        area.connect("draw", self.on_draw)
        area.connect("button-press-event", self.on_click)
        win.add(area)
        win.connect("destroy", lambda *_: self.quit())
        win.show_all()
        self.win, self.area = win, area

        self._listen_commands()
        if not demo:
            self._connect_hyprland()
            self._initial_window()
            GLib.timeout_add_seconds(3, self._poll_lock)
            self._start_idle_watcher()
        GLib.timeout_add(1000, self._tick)
        GLib.timeout_add(40, self._frame)
        try:
            gi.require_version("GLibUnix", "2.0")
            from gi.repository import GLibUnix
            add_signal = lambda sig: GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, self.quit)
        except (ImportError, ValueError):
            add_signal = lambda sig: GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self.quit)
        for sig in (signal.SIGINT, signal.SIGTERM):
            add_signal(sig)
        self.say("hi! I'm BEMO" if not demo else "hi! I'm BEMO. preview mode", 4)
        self._tick()

    # ------------------------------------------------------------ state

    def mode(self):
        now = time.monotonic()
        if self.demo:
            return self._demo_mode(now)
        if self.transient and now < self.transient[1]:
            return self.transient[0]
        if self.away or self.locked:
            return "sleep"
        if now < self.coffee_until:
            return "coffee"
        return self.activity

    DEMO = [
        ("idle", "just hanging out"),
        ("work", "you code, I code"),
        ("study", "study buddy mode"),
        ("coffee", "coffee break together"),
        ("sleep", "you're away... zzz"),
        ("wake", "welcome back! you were away 23m"),
        ("stretch", "50 min of focus. stretch with me?"),
    ]

    def _demo_mode(self, now):
        step = int((now - self.t0) // 7) % len(self.DEMO)
        if getattr(self, "_demo_step", None) != step:
            self._demo_step = step
            self.say(self.DEMO[step][1], 4.5)
        return self.DEMO[step][0]

    def say(self, text, seconds=4.0):
        now = time.monotonic()
        self.bubble = (text, now, now + seconds)

    def chatter(self, lines, cooldown=25):
        now = time.monotonic()
        if now - self.last_chatter >= cooldown:
            self.last_chatter = now
            self.say(random.choice(lines))

    def classify(self, cls, title):
        c, t = cls.lower(), title.lower()
        match = lambda pats: any(fnmatch(c, p.lower()) for p in pats)
        if match(self.cfg["study_classes"]):
            return "study"
        if match(self.cfg["work_classes"]):
            return "work"
        if match(self.cfg["browser_classes"]):
            if any(w in t for w in self.cfg["study_title_words"]):
                return "study"
            if any(w in t for w in self.cfg["work_title_words"]):
                return "work"
        return "idle"

    def set_window(self, cls, title):
        new = self.classify(cls, title)
        if new != self.activity:
            self.activity = new
            if self.mode() == new:
                if new == "work":
                    self.chatter(["let's build!", "you code, I code", "ship it!", "focus mode: on"])
                elif new == "study":
                    self.chatter(["study time!", "let's learn something", "page one...", "I'll read too"])

    def go_away(self):
        if not self.away:
            self.away = True
            self.away_since = self.away_since or time.monotonic()

    def come_back(self):
        if not (self.away or self.locked):
            return
        now = time.monotonic()
        gone = now - (self.away_since or now)
        self.away = self.locked = False
        self.away_since = None
        self.transient = ("wake", now + 4.5)
        self.say(f"welcome back! you were away {fmt_dur(gone)}" if gone >= 60 else "oh! hi again", 5)
        if gone >= 300:
            self.streak = 0

    def toggle_coffee(self):
        now = time.monotonic()
        if now < self.coffee_until:
            self.coffee_until = 0
            self.say("that was nice. back to it!")
        else:
            self.coffee_until = now + self.cfg["coffee_minutes"] * 60
            self._today()["coffee"] = self._today().get("coffee", 0) + 1
            self.say(random.choice(["coffee? count me in!", "cheers! *clink*",
                                    "two coffees, one desk", "ahh, the good stuff"]))

    # ------------------------------------------------------------ stats

    def _load_stats(self):
        try:
            return json.loads(STATS_FILE.read_text())
        except (OSError, ValueError):
            return {}

    def _save_stats(self):
        if self.demo:
            return
        today = date.today()
        keep = {k: v for k, v in self.stats.items()
                if (today - date.fromisoformat(k)).days < 60}
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = STATS_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(keep, indent=1))
        tmp.replace(STATS_FILE)

    def _today(self):
        return self.stats.setdefault(date.today().isoformat(), {"work": 0, "study": 0, "coffee": 0})

    def stats_line(self):
        d = self._today()
        return (f"today: {fmt_dur(d.get('work', 0) + d.get('study', 0))} focus, "
                f"{d.get('coffee', 0)} coffee{'s' if d.get('coffee', 0) != 1 else ''}")

    def _tick(self):
        now = time.monotonic()
        m = self.mode()
        if not self.demo and m in ("work", "study"):
            day = self._today()
            day[m] = day.get(m, 0) + 1
            self.streak += 1
            if self.streak >= self.cfg["break_minutes"] * 60:
                self.streak = 0
                self.transient = ("stretch", now + 6)
                msg = f"{self.cfg['break_minutes']} min of focus. stretch with me?"
                self.say(msg, 6)
                subprocess.Popen(["notify-send", "-a", "BEMO", "BEMO", msg],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            hour = datetime.now().hour
            if 0 <= hour < 5 and now - self.last_late_nudge > 45 * 60:
                self.last_late_nudge = now
                self.say("it's late... sleep soon?", 5)
        tick_n = int(now - self.t0)
        if tick_n % 5 == 0:
            self._write_status(m)
        if tick_n % 60 == 0:
            self._save_stats()
        return True

    def _write_status(self, m):
        face, words = MOODS.get(m, MOODS["idle"])
        d = self._today()
        tip = (f"{words}\nToday: {fmt_dur(d.get('work', 0))} work, {fmt_dur(d.get('study', 0))} study, "
               f"{d.get('coffee', 0)} coffee(s)\nClick: have a coffee together")
        focus = d.get("work", 0) + d.get("study", 0)
        out = {"text": f"{face} {fmt_dur(focus)}", "tooltip": tip, "class": m, "alt": m}
        try:
            STATUS.write_text(json.dumps(out))
        except OSError:
            pass

    # ------------------------------------------------------------ inputs

    def _listen_commands(self):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            probe.sendto(b"ping", str(SOCK))
            print("bemo is already running", file=sys.stderr)
            sys.exit(1)
        except (FileNotFoundError, ConnectionRefusedError):
            pass
        finally:
            probe.close()
        SOCK.unlink(missing_ok=True)
        self.cmd = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.cmd.bind(str(SOCK))
        self.GLib.io_add_watch(self.cmd.fileno(), self.GLib.IO_IN, self._on_command)

    def _on_command(self, *_):
        raw = self.cmd.recv(4096).decode(errors="replace").strip()
        word, _, rest = raw.partition(" ")
        if word == "coffee":
            self.toggle_coffee()
        elif word == "away":
            self.go_away()
        elif word == "back":
            self.come_back()
        elif word == "say" and rest:
            self.say(rest[:80], 5)
        elif word == "quit":
            self.quit()
        return True

    def _connect_hyprland(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not sig:
            print("bemo: not running under Hyprland; window detection is off", file=sys.stderr)
            return False
        try:
            self.ev = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.ev.connect(str(RUNTIME / "hypr" / sig / ".socket2.sock"))
            self.ev.setblocking(False)
        except OSError:
            self.GLib.timeout_add_seconds(3, self._connect_hyprland)
            return False
        self.GLib.io_add_watch(self.ev.fileno(),
                               self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR, self._on_event)
        return False

    def _on_event(self, _fd, cond):
        try:
            data = self.ev.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data or cond & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.ev.close()
            self.GLib.timeout_add_seconds(3, self._connect_hyprland)
            return False
        self.ev_buf += data
        *lines, self.ev_buf = self.ev_buf.split(b"\n")
        for line in lines:
            name, _, payload = line.decode(errors="replace").partition(">>")
            if name == "activewindow":
                cls, _, title = payload.partition(",")
                self.set_window(cls, title)
        return True

    def _initial_window(self):
        try:
            out = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True,
                                 text=True, timeout=2).stdout
            d = json.loads(out or "{}")
            self.set_window(d.get("class", ""), d.get("title", ""))
        except (OSError, ValueError, subprocess.SubprocessError):
            pass

    def _poll_lock(self):
        locked = subprocess.run(["pidof", "-q", "hyprlock"]).returncode == 0
        if locked and not self.locked:
            self.locked = True
            self.away_since = self.away_since or time.monotonic()
        elif not locked and self.locked:
            self.come_back()
        return True

    # ---- dragging: hold the left button and move BEMO along the bottom edge

    def _load_position(self):
        try:
            return int(json.loads((STATE_DIR / "position.json").read_text())["margin_right"])
        except (OSError, ValueError, KeyError, TypeError):
            return self.cfg["margin_right"]

    def _save_position(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        (STATE_DIR / "position.json").write_text(json.dumps({"margin_right": self.margin_right}))

    def _max_margin(self):
        try:
            gdk_win = self.win.get_window()
            mon = self.win.get_display().get_monitor_at_window(gdk_win)
            return max(0, mon.get_geometry().width - self.W)
        except Exception:
            return 4000

    def on_click(self, _w, ev):
        if ev.button == 1:
            self.press = [ev.x, False]
        return True

    def on_drag(self, _w, ev):
        if not self.press:
            return True
        dx = ev.x - self.press[0]
        if not self.press[1] and abs(dx) < 4:
            return True
        if not self.press[1]:
            self.press[1] = True
            self.say(random.choice(["wheee!", "where are we going?", "ooh, a road trip"]), 2)
        new = int(min(max(self.margin_right - dx, 0), self._max_margin()))
        if new != self.margin_right:
            # The surface moves under the pointer, so the grab point stays at press[0].
            self.drag_vx = self.drag_vx * 0.6 + (self.margin_right - new) * 0.4
            self.margin_right = new
            self.GtkLayerShell.set_margin(self.win, self.GtkLayerShell.Edge.RIGHT, new)
        return True

    def on_release(self, _w, ev):
        if ev.button == 3:
            self.toggle_coffee()
            return True
        if ev.button != 1 or not self.press:
            return True
        moved = self.press[1]
        self.press = None
        if moved:
            self.drag_vx = 0.0
            self.hop_until = time.monotonic() + 0.5
            self._save_position()
        else:
            self.hop_until = time.monotonic() + 0.5
            if self.mode() == "sleep":
                self.say("zzz... five more minutes...")
            else:
                self.say(self.stats_line(), 4)
        return True

    def _start_idle_watcher(self):
        """Run a private hypridle that only tells BEMO when you go idle and come back.

        It is separate from your own hypridle and its config: it never locks or suspends.
        """
        self.idle_proc = None
        me = f"{sys.executable} {Path(__file__).resolve()}"
        conf = RUNTIME / "bemo-hypridle.conf"
        conf.write_text(
            "general {\n    ignore_dbus_inhibit = false\n}\n"
            "listener {\n"
            f"    timeout = {max(10, int(self.cfg['away_minutes'] * 60))}\n"
            f"    on-timeout = {me} away\n"
            f"    on-resume = {me} back\n"
            "}\n")

        def die_with_parent():
            import ctypes
            ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG

        try:
            self.idle_proc = subprocess.Popen(
                ["hypridle", "-q", "-c", str(conf)], preexec_fn=die_with_parent,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as err:
            print(f"bemo: idle detection is off ({err})", file=sys.stderr)

    def quit(self, *_):
        if getattr(self, "idle_proc", None):
            self.idle_proc.terminate()
        self._save_stats()
        SOCK.unlink(missing_ok=True)
        STATUS.unlink(missing_ok=True)
        self.Gtk.main_quit()
        return False

    def _frame(self):
        self.area.queue_draw()
        return True

    def update_click_area(self, m, base_y):
        """Only BEMO itself takes clicks. The window is bigger than BEMO (room
        for speech bubbles above it), and clicks on that empty space should go
        to the window underneath, not to BEMO."""
        left, right = self.cx - 80, self.cx + 80        # body, arms, mug
        if m == "work":
            right = self.cx + 145                       # its laptop
        # top of its head (it bobs and hops a little), or of its night cap
        top = base_y - (110 if m == "sleep" else 94)
        bottom = base_y + 12                             # feet
        rect = (int(left), int(top), int(right - left), int(bottom - top))
        if rect == getattr(self, "_click_rect", None):
            return
        self._click_rect = rect
        x, y, w, h = rect
        region = self.cairo.Region(self.cairo.RectangleInt(max(x, 0), max(y, 0), w, h))
        self.win.input_shape_combine_region(region)

    # ------------------------------------------------------------ drawing

    def on_draw(self, _w, cr):
        cairo = self.cairo
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        now = time.monotonic()
        t = now - self.t0
        dt = min(now - self.last_frame, 0.1)
        self.last_frame = now
        m = self.mode()

        speed = {"work": 8, "study": 2.2, "idle": 1.0, "coffee": 1.5, "sleep": 0,
                 "wake": 5, "stretch": 3}.get(m, 1)
        self.reel_angle += speed * dt
        target_cx = 92 if m == "work" else self.W / 2
        self.cx += (target_cx - self.cx) * min(1, dt * 6)
        base_y = self.H - 16
        self.update_click_area(m, base_y)

        bob = {"idle": math.sin(t * 2) * 1.5,
               "work": abs(math.sin(t * 9)) * 0.8,
               "study": math.sin(t * 1.4) * 1.0,
               "coffee": math.sin(t * 2) * 1.2,
               "sleep": math.sin(t * 0.9) * 1.6,
               "wake": -abs(math.sin(t * 5)) * 4,
               "stretch": -abs(math.sin(t * 3)) * 3}.get(m, 0)
        if now < self.hop_until:
            bob -= math.sin((self.hop_until - now) / 0.5 * math.pi) * 10

        # ground shadow
        cr.save()
        cr.translate(self.cx, base_y + 7)
        cr.scale(1, 0.12)
        cr.arc(0, 0, 52 - bob, 0, 2 * math.pi)
        cr.set_source_rgba(0, 0, 0, 0.28)
        cr.fill()
        cr.restore()

        if m == "work":
            self.draw_laptop(cr, self.cx + 108, base_y, t)

        cr.save()
        cr.translate(self.cx, base_y + bob)
        tilt = {"sleep": -0.07, "study": 0.0, "work": 0.02}.get(m, 0.0)
        if self.press and self.press[1]:   # being carried: lean into the motion
            tilt += max(-0.35, min(0.35, self.drag_vx * 0.03))
            cr.translate(0, -8)
        self.drag_vx *= 0.85
        cr.rotate(tilt)
        if m == "stretch":
            cr.scale(1, 1 + 0.04 * math.sin(t * 3))
        self.draw_body(cr, t, m)
        cr.restore()

        if self.bubble and now < self.bubble[2]:
            self.draw_bubble(cr, self.bubble, now, base_y)

    # helpers
    @staticmethod
    def rrect(cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def gaze(self, t, m):
        if m == "work":
            return 0.55 + 0.3 * math.sin(t * 1.7), 0.45
        if m == "study":
            return -0.6 + ((t * 0.3) % 1) * 1.2, 0.75
        if m in ("wake", "stretch"):
            return 0, -0.6
        if m == "coffee":
            return 0.35, 0.3
        return (math.sin(t * 0.37) * 0.6 + math.sin(t * 0.13) * 0.35, math.sin(t * 0.23) * 0.35)

    def lid(self, t, m):
        if m == "sleep":
            return 1.0
        if m == "work":
            base = 0.25          # focused, slightly narrowed eyes
        elif m == "coffee":
            base = 0.15
        else:
            base = 0.0
        phase = (t + 1.3) % 4.1
        if phase < 0.16:
            return max(base, 1 - abs(phase - 0.08) / 0.08)
        return base

    def draw_body(self, cr, t, m):
        cairo = self.cairo
        # feet
        for fx in (-30, 30):
            self.rrect(cr, fx - 9, -4, 18, 9, 4)
            cr.set_source_rgba(*DIM)
            cr.fill()

        # arms behind the body for some poses are drawn later; body first
        g = cairo.LinearGradient(0, -82, 0, 0)
        g.add_color_stop_rgba(0, *BODY_TOP)
        g.add_color_stop_rgba(1, *BODY_BOT)
        self.rrect(cr, -62, -82, 124, 82, 12)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgba(*LINE)
        cr.set_line_width(2)
        cr.stroke()

        # corner screws
        for sx, sy in ((-55, -75), (55, -75), (-55, -7), (55, -7)):
            cr.arc(sx, sy, 2.2, 0, 2 * math.pi)
            cr.set_source_rgba(*LINE)
            cr.fill()

        # label strip with side "A"
        lg = cairo.LinearGradient(-52, 0, 52, 0)
        lg.add_color_stop_rgba(0, *MAGENTA)
        lg.add_color_stop_rgba(1, *BLUE)
        self.rrect(cr, -50, -76, 100, 17, 4)
        cr.set_source(lg)
        cr.fill()
        cr.arc(-40, -67.5, 5.5, 0, 2 * math.pi)
        cr.set_source_rgba(*BG)
        cr.fill()
        cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.5)
        cr.set_source_rgba(*FG)
        cr.move_to(-42.4, -64.8)
        cr.show_text("A")
        cr.set_font_size(9)
        cr.set_source_rgba(*BG)
        cr.move_to(-28, -64)
        cr.show_text("BEMO")
        cr.set_font_size(7)
        cr.move_to(20, -64)
        cr.show_text("C-60")

        # tape window
        self.rrect(cr, -44, -55, 88, 33, 8)
        cr.set_source_rgba(*WINDOW)
        cr.fill_preserve()
        cr.set_source_rgba(*LINE)
        cr.set_line_width(1.5)
        cr.stroke()
        # tape ribbon between the reels
        cr.move_to(-24, -26)
        cr.line_to(24, -26)
        cr.set_source_rgba(*TAPE)
        cr.set_line_width(2.5)
        cr.stroke()

        # eyes (the reels)
        gx, gy = self.gaze(t, m)
        lid = self.lid(t, m)
        sipping = m == "coffee" and self._sip_phase(t) > 0.15
        happy = sipping or m == "stretch" or (m == "idle" and (t % 17) < 1.2)
        for ex in (-24, 24):
            self.draw_eye(cr, ex, -38.5, 10, self.reel_angle * (1 if ex < 0 else 1.15), gx, gy, lid, happy)

        if m == "study":
            cr.set_source_rgba(*YELLOW)
            cr.set_line_width(1.8)
            for ex in (-24, 24):
                cr.new_sub_path()
                cr.arc(ex, -38.5, 15, 0, 2 * math.pi)
            cr.stroke()
            cr.move_to(-9, -40)
            cr.curve_to(-4, -44, 4, -44, 9, -40)
            cr.stroke()

        # blush
        for bx in (-49, 49):
            cr.save()
            cr.translate(bx, -16)
            cr.scale(1.6, 1)
            cr.arc(0, 0, 4, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(RED[0], RED[1], RED[2], 0.35)
            cr.fill()

        # mouth
        self.draw_mouth(cr, t, m, sipping)

        # bottom trapezoid with the two capstan holes
        cr.move_to(-30, -9)
        cr.line_to(30, -9)
        cr.line_to(36, 0)
        cr.line_to(-36, 0)
        cr.close_path()
        cr.set_source_rgba(*BODY_BOT)
        cr.fill_preserve()
        cr.set_source_rgba(*LINE)
        cr.set_line_width(1.2)
        cr.stroke()
        for hx in (-14, 14):
            cr.arc(hx, -4.5, 2, 0, 2 * math.pi)
            cr.set_source_rgba(*WINDOW)
            cr.fill()

        # per-mood props and arms
        getattr(self, f"pose_{m}", self.pose_idle)(cr, t)

    def draw_eye(self, cr, ex, ey, r, ang, gx, gy, lid, happy):
        cr.set_line_cap(self.cairo.LINE_CAP_ROUND)
        if happy:
            cr.arc(ex, ey + 4, r * 0.65, math.pi * 1.15, math.pi * 1.85)
            cr.set_source_rgba(*EYE)
            cr.set_line_width(2.4)
            cr.stroke()
            return
        if lid >= 0.97:
            cr.arc(ex, ey - 3, r * 0.65, math.pi * 0.15, math.pi * 0.85)
            cr.set_source_rgba(*FG)
            cr.set_line_width(2.2)
            cr.stroke()
            return
        # wound tape around the reel
        cr.arc(ex, ey, r + 2.6, 0, 2 * math.pi)
        cr.set_source_rgba(*TAPE)
        cr.fill()
        cr.arc(ex, ey, r, 0, 2 * math.pi)
        cr.set_source_rgba(*EYE)
        cr.fill()
        # hub = pupil, with spinning teeth
        px, py = ex + gx * r * 0.33, ey + gy * r * 0.33
        cr.arc(px, py, r * 0.5, 0, 2 * math.pi)
        cr.set_source_rgba(*BG)
        cr.fill()
        cr.set_source_rgba(*EYE)
        cr.set_line_width(1.5)
        for i in range(6):
            a = ang + i * math.pi / 3
            cr.move_to(px + math.cos(a) * r * 0.2, py + math.sin(a) * r * 0.2)
            cr.line_to(px + math.cos(a) * r * 0.4, py + math.sin(a) * r * 0.4)
        cr.stroke()
        cr.arc(px - r * 0.2, py - r * 0.24, r * 0.12, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.9)
        cr.fill()
        if lid > 0.01:
            cr.save()
            cr.arc(ex, ey, r + 2.7, 0, 2 * math.pi)
            cr.clip()
            h = (2 * r + 6) * lid
            cr.rectangle(ex - r - 3, ey - r - 3, 2 * r + 6, h)
            cr.set_source_rgba(*BODY_TOP)
            cr.fill()
            cr.move_to(ex - r - 3, ey - r - 3 + h)
            cr.line_to(ex + r + 3, ey - r - 3 + h)
            cr.set_source_rgba(*LINE)
            cr.set_line_width(1.4)
            cr.stroke()
            cr.restore()

    def draw_mouth(self, cr, t, m, sipping):
        cr.set_source_rgba(*FG)
        cr.set_line_width(1.8)
        cr.set_line_cap(self.cairo.LINE_CAP_ROUND)
        y = -15.5
        if m == "wake":
            cr.save(); cr.translate(0, y); cr.scale(1, 1.3)
            cr.arc(0, 0, 3.6, 0, 2 * math.pi); cr.restore()
            cr.set_source_rgba(*WINDOW); cr.fill_preserve()
            cr.set_source_rgba(*FG); cr.stroke()
        elif sipping:
            cr.arc(0, y, 2, 0, 2 * math.pi)
            cr.stroke()
        elif m == "sleep":
            cr.move_to(-3, y); cr.line_to(3, y); cr.stroke()
        elif m == "work":
            cr.move_to(-4, y); cr.curve_to(-1, y + 1.5, 1, y + 1.5, 4, y); cr.stroke()
        else:
            cr.arc(0, y - 3, 5, math.pi * 0.2, math.pi * 0.8)
            cr.stroke()

    def arm(self, cr, side, hx, hy):
        sx, sy = 60 * side, -38
        cr.move_to(sx, sy)
        cr.curve_to(sx + 14 * side, sy + 4, hx + 4 * side, hy - 10, hx, hy)
        cr.set_source_rgba(*TAPE)
        cr.set_line_width(3.2)
        cr.set_line_cap(self.cairo.LINE_CAP_ROUND)
        cr.stroke()
        cr.arc(hx, hy, 4.6, 0, 2 * math.pi)
        cr.set_source_rgba(*BODY_TOP)
        cr.fill_preserve()
        cr.set_source_rgba(*LINE)
        cr.set_line_width(1.2)
        cr.stroke()

    # ---- poses

    def pose_idle(self, cr, t):
        self.arm(cr, -1, -70, -16 + math.sin(t * 2) * 1.5)
        wave = (t % 13) < 1.6
        if wave:
            self.arm(cr, 1, 74 + math.sin(t * 14) * 5, -66)
        else:
            self.arm(cr, 1, 70, -16 + math.sin(t * 2 + 1) * 1.5)
        if (t % 23) < 2.5:  # hums a little tune
            ph = (t % 23) / 2.5
            cr.select_font_face(FONT, self.cairo.FONT_SLANT_NORMAL, self.cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(13)
            cr.set_source_rgba(CYAN[0], CYAN[1], CYAN[2], 1 - ph)
            cr.move_to(48 + ph * 12, -86 - ph * 16)
            cr.show_text("♪")

    def pose_work(self, cr, t):
        self.arm(cr, -1, -68, -18)
        tap = abs(math.sin(t * 11)) * 3
        self.arm(cr, 1, 86 + (int(t * 5) % 3) * 6, -10 - tap)
        if (t % 9) < 1.6:  # a little "+1" for a job well done
            ph = (t % 9) / 1.6
            cr.select_font_face(FONT, self.cairo.FONT_SLANT_NORMAL, self.cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(10)
            cr.set_source_rgba(GREEN[0], GREEN[1], GREEN[2], 1 - ph)
            cr.move_to(96, -66 - ph * 14)
            cr.show_text("+1")

    def draw_laptop(self, cr, lx, by, t):
        # screen
        self.rrect(cr, lx - 34, by - 50, 66, 44, 4)
        cr.set_source_rgba(*DIM)
        cr.fill()
        cr.rectangle(lx - 31, by - 47, 60, 38)
        cr.set_source_rgba(*WINDOW)
        cr.fill()
        cr.save()
        cr.rectangle(lx - 31, by - 47, 60, 38)
        cr.clip()
        scroll = t * 7
        first = int(scroll // 6)
        colors = (BLUE, GREEN, MAGENTA, CYAN, ORANGE, FG)
        for i in range(first, first + 8):
            rnd = random.Random(i)
            y = by - 44 + (i * 6 - scroll)
            indent = rnd.choice((0, 0, 5, 10))
            x = lx - 28 + indent
            for _ in range(rnd.randint(1, 3)):
                w = rnd.randint(5, 16)
                if x + w > lx + 26:
                    break
                cr.rectangle(x, y, w, 2.4)
                cr.set_source_rgba(*rnd.choice(colors))
                cr.fill()
                x += w + 3
        if int(t * 2) % 2:
            cr.rectangle(lx + 18, by - 16, 4, 4)
            cr.set_source_rgba(*FG)
            cr.fill()
        cr.restore()
        # base / keyboard
        self.rrect(cr, lx - 42, by - 7, 82, 8, 3)
        cr.set_source_rgba(*LINE)
        cr.fill()
        for k in range(9):
            cr.rectangle(lx - 36 + k * 8, by - 5, 5, 1.8)
            cr.set_source_rgba(*DIM)
            cr.fill()
        # glow from the screen
        cr.rectangle(lx - 31, by - 47, 60, 38)
        cr.set_source_rgba(BLUE[0], BLUE[1], BLUE[2], 0.05 + 0.03 * math.sin(t * 3))
        cr.fill()

    def pose_study(self, cr, t):
        # book cover
        self.rrect(cr, -42, -27, 84, 32, 3)
        cr.set_source_rgba(*MAGENTA)
        cr.fill()
        # pages
        for side in (-1, 1):
            cr.move_to(0, -21)
            cr.curve_to(side * 14, -26, side * 28, -26, side * 39, -23)
            cr.line_to(side * 39, 2)
            cr.curve_to(side * 28, -1, side * 14, -1, 0, 3)
            cr.close_path()
            cr.set_source_rgba(*PAGE)
            cr.fill()
            for ln in range(4):
                y = -17 + ln * 4.5
                cr.move_to(side * 6, y)
                cr.line_to(side * (30 - (ln % 2) * 7), y - 1)
            cr.set_source_rgba(0.45, 0.45, 0.5, 0.8)
            cr.set_line_width(1.2)
            cr.stroke()
        # page flip every 7 seconds
        ph = (t % 7) / 0.9
        if ph < 1:
            x = 39 * math.cos(ph * math.pi)
            cr.move_to(0, -21)
            cr.curve_to(x * 0.4, -30, x * 0.8, -28, x, -25)
            cr.line_to(x, 1)
            cr.curve_to(x * 0.8, -3, x * 0.4, -2, 0, 3)
            cr.close_path()
            cr.set_source_rgba(1, 0.98, 0.92, 1)
            cr.fill()
        cr.move_to(0, -21)
        cr.line_to(0, 3)
        cr.set_source_rgba(*LINE)
        cr.set_line_width(1)
        cr.stroke()
        self.arm(cr, -1, -40, -8)
        self.arm(cr, 1, 40, -8)
        if (t % 15) < 2:  # an idea!
            ph = (t % 15) / 2
            a = min(1, ph * 4) * (1 - max(0, ph - 0.8) * 5)
            cx, cy = 52, -96
            for i in range(5):
                ang = -math.pi / 2 + (i - 2) * 0.5
                cr.move_to(cx + math.cos(ang) * 10, cy + math.sin(ang) * 10)
                cr.line_to(cx + math.cos(ang) * 14, cy + math.sin(ang) * 14)
            cr.set_source_rgba(YELLOW[0], YELLOW[1], YELLOW[2], a)
            cr.set_line_width(1.6)
            cr.stroke()
            cr.arc(cx, cy, 6.5, 0, 2 * math.pi)
            cr.fill()
            cr.rectangle(cx - 3, cy + 6, 6, 4)
            cr.set_source_rgba(LINE[0], LINE[1], LINE[2], a)
            cr.fill()

    def _sip_phase(self, t):
        p = (t % 6.5) / 2.2
        return math.sin(p * math.pi) if p < 1 else 0.0

    def pose_coffee(self, cr, t):
        s = self._sip_phase(t)
        mx = 62 + (12 - 62) * s
        my = -24 + (-20 + 24) * s
        self.arm(cr, -1, -68, -20 + math.sin(t * 2) * 1.2)
        self.arm(cr, 1, mx + 8, my + 2)
        cr.save()
        cr.translate(mx, my)
        cr.rotate(-0.55 * s)
        # handle
        cr.arc(8, 0, 4.5, -math.pi / 2, math.pi / 2)
        cr.set_source_rgba(*FG)
        cr.set_line_width(2.2)
        cr.stroke()
        # cup
        self.rrect(cr, -8, -8, 16, 17, 3)
        cr.set_source_rgba(*FG)
        cr.fill()
        cr.rectangle(-8, -1, 16, 3.5)
        cr.set_source_rgba(*ORANGE)
        cr.fill()
        cr.save()
        cr.translate(0, -7.5)
        cr.scale(1, 0.3)
        cr.arc(0, 0, 7, 0, 2 * math.pi)
        cr.restore()
        cr.set_source_rgba(*TAPE)
        cr.fill()
        cr.restore()
        # steam
        if s < 0.2:
            cr.set_line_width(1.5)
            for k in range(3):
                ph = ((t * 0.6) + k / 3) % 1
                cr.set_source_rgba(1, 1, 1, 0.45 * (1 - ph))
                x0 = mx - 4 + k * 4
                for j in range(9):
                    y = my - 11 - j * 2.2 - ph * 6
                    x = x0 + math.sin(j * 0.7 + t * 3 + k) * 1.8
                    (cr.move_to if j == 0 else cr.line_to)(x, y)
                cr.stroke()

    def pose_sleep(self, cr, t):
        self.arm(cr, -1, -60, -6)
        self.arm(cr, 1, 60, -6)
        # night cap
        cr.move_to(-50, -80)
        cr.curve_to(-46, -100, -36, -108, -14, -82)
        cr.close_path()
        cr.set_source_rgba(*MAGENTA)
        cr.fill()
        self.rrect(cr, -53, -85, 42, 7, 3.5)
        cr.set_source_rgba(*EYE)
        cr.fill()
        tipx, tipy = -64 + math.sin(t * 0.9) * 1.5, -96
        cr.move_to(-38, -102)
        cr.curve_to(-48, -106, -58, -104, tipx, tipy)
        cr.set_source_rgba(*MAGENTA)
        cr.set_line_width(5)
        cr.stroke()
        cr.arc(tipx, tipy, 4.5, 0, 2 * math.pi)
        cr.set_source_rgba(*EYE)
        cr.fill()
        # floating z's
        cr.select_font_face(FONT, self.cairo.FONT_SLANT_NORMAL, self.cairo.FONT_WEIGHT_BOLD)
        for k in range(3):
            ph = ((t / 3.2) + k / 3) % 1
            cr.set_font_size(8 + ph * 9)
            cr.set_source_rgba(BLUE[0], BLUE[1], BLUE[2], math.sin(ph * math.pi))
            cr.move_to(52 + ph * 22, -78 - ph * 40)
            cr.show_text("z")

    def pose_wake(self, cr, t):
        self.arm(cr, -1, -54, -96 + math.sin(t * 6) * 3)
        self.arm(cr, 1, 54, -96 - math.sin(t * 6) * 3)

    def pose_stretch(self, cr, t):
        a = math.sin(t * 3)
        self.arm(cr, -1, -50 - a * 6, -98 + a * 4)
        self.arm(cr, 1, 50 - a * 6, -98 - a * 4)

    def draw_bubble(self, cr, bubble, now, base_y):
        text, start, until = bubble
        alpha = min(1, (now - start) / 0.25, (until - now) / 0.4)
        cr.select_font_face(FONT, self.cairo.FONT_SLANT_NORMAL, self.cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(11)
        # wrap to the window width
        lines, cur = [], ""
        for word in text.split():
            trial = f"{cur} {word}".strip()
            if cur and cr.text_extents(trial).x_advance > self.W - 34:
                lines.append(cur)
                cur = word
            else:
                cur = trial
        lines.append(cur)
        tw = max(cr.text_extents(l).x_advance for l in lines)
        bw, bh = tw + 20, 12 + 15 * len(lines)
        bx = min(max(self.cx - bw / 2, 4), self.W - bw - 4)
        by = base_y - 116 - bh
        self.rrect(cr, bx, by, bw, bh, 9)
        cr.set_source_rgba(BG[0], BG[1], BG[2], 0.93 * alpha)
        cr.fill_preserve()
        cr.set_source_rgba(BLUE[0], BLUE[1], BLUE[2], alpha)
        cr.set_line_width(1.5)
        cr.stroke()
        tx = min(max(self.cx, bx + 14), bx + bw - 14)
        cr.move_to(tx - 6, by + bh - 0.8)
        cr.line_to(tx, by + bh + 8)
        cr.line_to(tx + 6, by + bh - 0.8)
        cr.set_source_rgba(BG[0], BG[1], BG[2], 0.93 * alpha)
        cr.fill_preserve()
        cr.set_source_rgba(BLUE[0], BLUE[1], BLUE[2], alpha)
        cr.stroke()
        cr.set_source_rgba(FG[0], FG[1], FG[2], alpha)
        for i, line in enumerate(lines):
            cr.move_to(bx + 10, by + 17 + i * 15)
            cr.show_text(line)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "run"
    if cmd == "run":
        buddy = Bemo(demo="--demo" in argv)
        buddy.Gtk.main()
        return 0
    if cmd in ("coffee", "away", "back", "quit"):
        return send(cmd)
    if cmd == "say":
        return send("say " + " ".join(argv[2:]))
    if cmd == "waybar":
        print_waybar()
        return 0
    if cmd == "stats":
        print_stats()
        return 0
    print(__doc__)
    return 0 if cmd in ("-h", "--help", "help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
