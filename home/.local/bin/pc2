#!/bin/bash
# Start the PC2 team client (the program contests use to submit solutions).
#
#   pc2                  use the kit in ~/cp/PC2-team-contest
#   pc2 ~/Desktop/kit    use a kit somewhere else
#
# The kit is the folder the contest admin gives you, with bin/ and lib/ in it.
# Set the server address in bin/pc2v9.ini first (the admin tells you).
# PC2 runs on Java 17 (package jre17-openjdk), so this uses Java 17 even when
# your default Java is newer.

kit="${1:-$HOME/cp/PC2-team-contest}"
if [[ ! -d $kit/bin || ! -d $kit/lib ]]; then
    echo "No PC2 kit found in $kit (it needs the bin and lib folders)." >&2
    echo "Usage: pc2 [kit folder]" >&2
    exit 1
fi

java=/usr/lib/jvm/java-17-openjdk/bin/java
if [[ ! -x $java ]]; then
    echo "Java 17 isn't installed (sudo pacman -S jre17-openjdk). Trying your default Java." >&2
    java=java
fi

# PC2 reads bin/pc2v9.ini and writes its logs in bin/logs, so start it from bin
cd "$kit/bin" || exit 1
exec "$java" -Djdk.crypto.KeyAgreement.legacyKDF=true -Xms64M -Xmx768M \
    -cp '../lib/*' edu.csus.ecs.pc2.Starter
