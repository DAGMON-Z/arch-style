#!/bin/bash
# Start the PC2 team client (the program contests use to submit solutions).
#
#   pc2                  use the kit in ~/cp/PC2-team-contest
#   pc2 ~/Desktop/kit    use a kit somewhere else
#
# The kit is the folder the contest admin gives you, with bin/ and lib/ in it.
# Set the server address in bin/pc2v9.ini first (the admin tells you).
# PC2 runs on Java 17 (package jre17-openjdk), so this uses Java 17 even when
# your default Java is newer.

kit="${1:-$HOME/cp/PC2-team-contest}"
if [[ ! -d $kit/bin || ! -d $kit/lib ]]; then
    echo "No PC2 kit found in $kit (it needs the bin and lib folders)." >&2
    echo "Usage: pc2 [kit folder]" >&2
    exit 1
fi

java=/usr/lib/jvm/java-17-openjdk/bin/java
if [[ ! -x $java ]]; then
    echo "Java 17 isn't installed (sudo pacman -S jre17-openjdk). Trying your default Java." >&2
    java=java
fi

# Sharp on scaled screens: Hyprland draws XWayland apps (Java is one) at 100%
# without stretching (force_zero_scaling in hyprland.lua), so they're sharp.
# Java on Linux can only scale by whole numbers (1, 2, 3), so use the screen's
# scale rounded down: 1 at 125% or 133% (sharp but a bit small), 2 at 200%.
scale=$(hyprctl monitors -j 2>/dev/null |
    python3 -c 'import json,sys; print(max(1, int(next((m["scale"] for m in json.load(sys.stdin) if m["focused"]), 1) + 0.01)))' 2>/dev/null)
scale=${scale:-1}

# Java options:
#   uiScale                   draw everything at that whole-number scale
#   useSystemAAFontSettings   smooth (anti-aliased) text instead of jagged text
#   swing.aatext              the same for older Swing code
opts=(
    -Dsun.java2d.uiScale="$scale"
    -Dawt.useSystemAAFontSettings=on
    -Dswing.aatext=true
)

# PC2 reads bin/pc2v9.ini and writes its logs in bin/logs, so start it from bin
cd "$kit/bin" || exit 1
exec "$java" "${opts[@]}" -Djdk.crypto.KeyAgreement.legacyKDF=true -Xms64M -Xmx768M \
    -cp '../lib/*' edu.csus.ecs.pc2.Starter
