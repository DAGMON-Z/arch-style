# The system keyring for every app (the "Secret Service", org.freedesktop.secrets).
# KDE's own desktop starts KWallet's ksecretd at login; Hyprland doesn't, so
# apps found no keyring. With this file, the first app that asks starts it.
# keyring-start connects the keyring your login already unlocked, or starts
# KWallet's ksecretd if there isn't one.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=@HOME@/.local/bin/keyring-start --dbus
